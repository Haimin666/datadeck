# 复制为 .env.docker 后填写实际配置
DATADECK_ENV=production
JWT_SECRET_KEY=please-change-to-a-random-string-at-least-32-characters

DATADECK_MODEL=openai:gpt-4o
DATADECK_MODEL_PROVIDER=openai
DATADECK_API_KEY=
DATADECK_BASE_URL=

# 可选：配置后启用向量检索；未配置时使用 BM25 关键词检索
DATADECK_EMBEDDING_API_KEY=
DATADECK_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
DATADECK_EMBEDDING_MODEL=BAAI/bge-m3

# 可选的外部数据源
DATADECK_OMD_URL=
DATADECK_OMD_API_KEY=
