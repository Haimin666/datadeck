# 复制为 .env.docker 后填写实际配置
DATADECK_ENV=production
JWT_SECRET_KEY=please-change-to-a-random-string-at-least-32-characters
POSTGRES_PASSWORD=please-change-to-a-strong-password
DATADECK_PORT=8000
DATADECK_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
QDRANT_PORT=6333
QDRANT_BIND_ADDRESS=127.0.0.1

DATADECK_MODEL=openai:gpt-4o
DATADECK_MODEL_PROVIDER=openai
DATADECK_API_KEY=
DATADECK_BASE_URL=
DATADECK_MODEL_TEMPERATURE=0.0
DATADECK_MODEL_TIMEOUT=90
DATADECK_AGENT_RUN_TIMEOUT=180
DATADECK_TOKEN_BUDGET=60000
DATADECK_TOKEN_HARD_LIMIT=100000

# 可选：配置后启用向量检索；未配置时使用 BM25 关键词检索
DATADECK_EMBEDDING_API_KEY=
DATADECK_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
DATADECK_EMBEDDING_MODEL=BAAI/bge-m3

# 可选的外部数据源（OpenMetadata）
OMD_BASE_URL=
OMD_TOKEN=
OMD_SERVICE=数仓Doris
OMD_DATABASE=default
DATADECK_OMD_SSL_VERIFY=true

# 可选：真实数仓只读连接；不要填写 DataDeck 自身的 PostgreSQL
DATADECK_SQL_DSN=
DATADECK_SQL_DIALECT=doris
# 可选数据源边界：逗号分隔；为空表示交由只读数据源账号控制
DATADECK_SQL_ALLOWED_SCHEMAS=
DATADECK_SQL_DENIED_TABLES=
DATADECK_SQL_DENIED_COLUMNS=
DATADECK_SQL_MAX_ROWS=200
DATADECK_SQL_EXPLAIN_MAX_ROWS=50000000

# 应用持久化目录（Compose 已将 /app/data 挂载到宿主机 ./data）
DATADECK_DATA_ROOT=/app/data
DATADECK_RUNTIME_DIR=/app/data/runtime
DATADECK_SKILL_DATA_DIR=/app/data/skill-sources
DATADECK_SKILL_PROJECTION_DIR=/app/data/skill-projections
DATADECK_USER_DATA_DIR=/app/data/user-data

# RAG 与事件流
DATADECK_RAG_COLLECTION=datadeck_kb
DATADECK_RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
DATADECK_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RUN_SSE_HEARTBEAT_SECONDS=15
RUN_SSE_POLL_INTERVAL_SECONDS=1.0
RUN_SSE_MAX_CONNECTION_MINUTES=30
TASKER_DEFAULT_TIMEOUT_SECONDS=21600

# 模型网络代理（仅模型请求使用；不要填写宿主机 127.0.0.1 地址）
DATADECK_MODEL_HTTP_PROXY=
# MCP 默认直连；只有 MCP 服务明确需要代理时才填写
DATADECK_MCP_HTTP_PROXY=

# 生产环境必须关闭；仅本地调试时可设为 true
DATADECK_AGENT_ALLOW_ALL_ACTIONS=false

# 临时会话工作目录：无项目绑定的 Agent 会话使用；默认保留 7 天
TEMP_SESSION_ROOT=/tmp/datadeck-sessions
TEMP_SESSION_TTL_DAYS=7
