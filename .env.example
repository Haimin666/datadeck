# datadeck 模型配置（经 ModelProvider 适配器读取）
# spec 格式: provider:model_id
DATADECK_MODEL=openai:gpt-4o
# provider 类型: openai | anthropic | gemini
DATADECK_MODEL_PROVIDER=openai
DATADECK_API_KEY=
DATADECK_BASE_URL=
DATADECK_MODEL_TEMPERATURE=0.0
# MCP 默认直连；只有 MCP 服务明确需要代理时才填写
DATADECK_MCP_HTTP_PROXY=
# 可选 SQL schema/表/字段边界（逗号分隔）
DATADECK_SQL_ALLOWED_SCHEMAS=
DATADECK_SQL_DENIED_TABLES=
DATADECK_SQL_DENIED_COLUMNS=
# 仅本地能力测试：跳过人工审批；生产环境必须为 false
DATADECK_AGENT_ALLOW_ALL_ACTIONS=false

# 临时会话工作目录：无项目绑定的 Agent 会话使用；默认保留 7 天
TEMP_SESSION_ROOT=/tmp/datadeck-sessions
TEMP_SESSION_TTL_DAYS=7
